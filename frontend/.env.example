# ================================
# FRONTEND ENVIRONMENT VARIABLES
# ================================
# Copy this file to .env and update with your actual values
# For production, set these variables in your Vercel dashboard

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api

# External APIs
VITE_NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search
VITE_OPENCAGE_API_URL=https://api.opencagedata.com/geocode/v1/json
VITE_OPENCAGE_API_KEY=your_opencage_api_key_here

# Application Settings
VITE_APP_NAME="CargoNepal"
VITE_DEFAULT_MAP_CENTER_LAT=27.7172
VITE_DEFAULT_MAP_CENTER_LNG=85.3240
VITE_DEFAULT_MAP_ZOOM=12

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_TOOLS=true

# Logging
# Options: ERROR, WARN, INFO, DEBUG, TRACE
# Default: DEBUG in development, ERROR in production
VITE_LOG_LEVEL=DEBUG
VITE_ENABLE_REDUX_LOGGER=true
