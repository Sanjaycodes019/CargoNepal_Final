# ================================
# PRODUCTION ENVIRONMENT VARIABLES
# ================================
# Set these in your Vercel dashboard environment variables

# Backend API URL
VITE_API_BASE_URL=https://your-app-name.onrender.com/api

# External APIs
VITE_NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search
VITE_OPENCAGE_API_URL=https://api.opencagedata.com/geocode/v1/json
VITE_OPENCAGE_API_KEY=your-opencage-api-key

# Logging (Set to ERROR for production to reduce logs)
VITE_LOG_LEVEL=ERROR
